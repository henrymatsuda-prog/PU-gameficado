<script>
  // ============ DADOS ============
  const trainings = [
    {id:1,name:'Drible em Zigue-Zague',desc:'Treino de condução e drible em zigue-zague utilizando cones para melhorar o controle de bola e mudanças de direção.',modality:'campo',skill:'Drible / Finta',category:'Técnico',difficulty:'Médio',duration:'10 min',icon:'⚽',video:'https://www.youtube.com/shorts/8ID3oNim4Q4'},
    {id:2,name:'Corrida Intervalada',desc:'Aumente sua resistência aeróbia com sprints de alta intensidade.',modality:'campo',skill:'Resistência Aeróbia',category:'Físico',difficulty:'Médio',duration:'15 min',icon:'🏃'},
    {id:3,name:'Finalização Precisa',desc:'Melhore sua pontaria com finalizações de primeira em alvos específicos.',modality:'campo',skill:'Finalização',category:'Técnico',difficulty:'Fácil',duration:'12 min',icon:'🎯'},
    {id:4,name:'Power Clean',desc:'Desenvolva explosão e potência com levantamento olímpico.',modality:'academia',skill:'Explosão / Potência',category:'Físico',difficulty:'Alto',duration:'20 min',icon:'🏋️'},
    {id:5,name:'Squat Jumps',desc:'Pliometria para explosão de membros inferiores.',modality:'casa',skill:'Explosão / Potência',category:'Físico',difficulty:'Médio',duration:'10 min',icon:'💪'},
    {id:6,name:'Passe Contra a Parede',desc:'Melhore seu passe curto e controle orientado.',modality:'casa',skill:'Passe Curto',category:'Técnico',difficulty:'Fácil',duration:'15 min',icon:'🧱'},
    {id:7,name:'Sled Push (Trenó)',desc:'Força e aceleração com empurrar trenó de carga.',modality:'academia',skill:'Aceleração',category:'Físico',difficulty:'Alto',duration:'15 min',icon:'🛷'},
    {id:8,name:'Rondo 4x2',desc:'4 pessoas com posse de bola e 2 marcadores tentando recuperar a bola, trabalhando a posse e a recuperação em espaço reduzido.',modality:'campo',skill:'Visão de Jogo',category:'Tático',difficulty:'Médio',duration:'20 min',icon:'🔄',video:'https://www.youtube.com/shorts/SQ_tPWet61A'},
    {id:9,name:'Embaixadinhas',desc:'Controle de bola e coordenação motora fina.',modality:'casa',skill:'Domínio de Bola',category:'Técnico',difficulty:'Fácil',duration:'10 min',icon:'🎪'},
    {id:10,name:'Nordic Hamstring',desc:'Prevenção de lesões e força de isquiotibiais.',modality:'academia',skill:'Velocidade Máxima',category:'Físico',difficulty:'Alto',duration:'15 min',icon:'🦵'},
    {id:11,name:'1x1 em Corredor',desc:'Drible e contenção em espaço reduzido no corredor, focado em superar o marcador ou proteger a bola em situações de 1 contra 1.',modality:'campo',skill:'Duelo 1x1',category:'Técnico',difficulty:'Médio',duration:'15 min',icon:'⚔️',video:'https://youtu.be/AnXtVLdYR8s?si=08J8qm6bMufo-9xa'},
    {id:12,name:'Meditação Mindfulness',desc:'Foco e concentração através de respiração guiada.',modality:'casa',skill:'Concentração',category:'Mental',difficulty:'Fácil',duration:'10 min',icon:'🧘'}
  ];

  const achievements = [
    {name:'Mestre do Drible',desc:'Nível 3 em Drible',icon:'⭐',type:'gold',unlocked:true},
    {name:'Velocidade Máxima',desc:'10 sprints completos',icon:'⚡',type:'silver',unlocked:true},
    {name:'Sequência Perfeita',desc:'7 dias seguidos',icon:'🔥',type:'bronze',unlocked:true},
    {name:'Muralha',desc:'10 desarmes em treino',icon:'🛡️',type:'gold',unlocked:false},
    {name:'Líder Nato',desc:'Nível 5 em Mental',icon:'👑',type:'silver',unlocked:false}
  ];

  // ============ NAVEGAÇÃO ============
  function navigateTo(page){
    document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
    document.getElementById('page-'+page).classList.add('active');
    const navItem = document.querySelector(`.nav-item[data-page="${page}"]`);
    if(navItem) navItem.classList.add('active');
    document.querySelector('.sidebar').classList.remove('open');
    window.scrollTo(0,0);
    if(page==='desempenho') setTimeout(initPerformanceCharts,100);
  }
  document.querySelectorAll('.nav-item').forEach(item=>{
    item.addEventListener('click',()=>navigateTo(item.dataset.page));
  });

  // ============ MODAIS ============
  function openModal(id){document.getElementById(id).classList.add('active')}
  function closeModal(id){document.getElementById(id).classList.remove('active')}
  function openCompletionModal(){openModal('modalConclusao')}
  function openValidationModal(){openModal('modalValidacao')}

  // ============ TREINAMENTOS ============
  function renderTrainings(containerId, list){
    const container = document.getElementById(containerId);
    if(!container) return;
    container.innerHTML = list.map(t=>`
      <div class="training-card" onclick="openExercise(${t.id})">
        <div class="training-icon">${t.icon}</div>
        <div class="training-name">${t.name}</div>
        <div class="training-desc">${t.desc}</div>
        <div class="training-meta">
          <span>📂 ${t.modality==='academia'?'Academia':t.modality==='campo'?'Campo':'Casa'}</span>
          <span>⚡ ${t.difficulty}</span>
          <span>⏱️ ${t.duration}</span>
        </div>
      </div>
    `).join('');
  }

  function openExercise(id){
    const t = trainings.find(x=>x.id===id);
    if(!t) return;
    document.getElementById('exName').textContent = t.name;
    document.getElementById('exDesc').textContent = t.desc;
    document.getElementById('exModality').textContent = t.modality==='academia'?'Academia':t.modality==='campo'?'Campo':'Casa';
    document.getElementById('exSkill').textContent = t.skill;
    document.getElementById('exDifficulty').textContent = t.difficulty;
    document.getElementById('exDuration').textContent = t.duration;
    document.getElementById('exCategory').textContent = t.category;
    
    // Handle video embedding
    const videoContainer = document.getElementById('exVideo');
    if (t.video) {
      let embedUrl = t.video;
      if (embedUrl.includes('youtube.com/shorts/')) {
        const videoId = embedUrl.split('/shorts/')[1].split('?')[0];
        embedUrl = `https://www.youtube.com/embed/${videoId}`;
      } else if (embedUrl.includes('youtu.be/')) {
        const videoId = embedUrl.split('youtu.be/')[1].split('?')[0];
        embedUrl = `https://www.youtube.com/embed/${videoId}`;
      } else if (embedUrl.includes('youtube.com/watch?v=')) {
        const videoId = embedUrl.split('v=')[1].split('&')[0];
        embedUrl = `https://www.youtube.com/embed/${videoId}`;
      }
      videoContainer.innerHTML = `<iframe width="100%" height="100%" src="${embedUrl}" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="border-radius:12px;"></iframe>`;
    } else {
      videoContainer.innerHTML = `▶️ Vídeo do YouTube/Instagram incorporado aqui<br><small style="margin-top:8px;display:block">(Link cadastrado pelo administrador)</small>`;
    }
    
    navigateTo('exercicio');
  }

  renderTrainings('trainingsCatalog', trainings);
  renderTrainings('recommendedTrainings', trainings.slice(0,3));

  // ============ FILTROS ============
  document.querySelectorAll('.filter-btn').forEach(btn=>{
    btn.addEventListener('click',function(){
      this.parentElement.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
      this.classList.add('active');
      
      const filter = this.dataset.filter;
      if(!filter) return;
      
      let filtered = trainings;
      if(filter!=='todos'){
        filtered = trainings.filter(t=>{
          if(['academia','campo','casa'].includes(filter)) return t.modality===filter;
          if(filter==='tecnico') return t.category==='Técnico';
          if(filter==='fisico') return t.category==='Físico';
          if(filter==='tatico') return t.category==='Tático';
          return true;
        });
      }
      renderTrainings('trainingsCatalog', filtered);
    });
  });

  // ============ GRÁFICOS ============
  function initPerformanceCharts(){
    const radarCtx = document.getElementById('radarChart');
    if(radarCtx){
      new Chart(radarCtx, {
        type: 'radar',
        data: {
          labels: ['Ataque', 'Técnica', 'Velocidade', 'Físico', 'Defesa', 'Mental'],
          datasets: [{
            label: 'Seu Nível',
            data: [82, 85, 78, 75, 70, 65],
            borderColor: '#39ff14',
            backgroundColor: 'rgba(57,255,20,0.2)',
            pointBackgroundColor: '#39ff14'
          }, {
            label: 'Média da Categoria',
            data: [70, 72, 68, 70, 65, 60],
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59,130,246,0.1)',
            pointBackgroundColor: '#3b82f6'
          }]
        },
        options: {
          responsive: true,
          scales: {
            r: {
              angleLines: { color: 'rgba(255,255,255,0.1)' },
              grid: { color: 'rgba(255,255,255,0.1)' },
              pointLabels: { color: '#9ca3af', font: { size: 12 } },
              ticks: { display: false, max: 100 }
            }
          },
          plugins: {
            legend: { labels: { color: '#ffffff' } }
          }
        }
      });
    }

    const lineCtx = document.getElementById('lineChart');
    if(lineCtx){
      new Chart(lineCtx, {
        type: 'line',
        data: {
          labels: ['Sem 1', 'Sem 2', 'Sem 3', 'Sem 4'],
          datasets: [{
            label: 'Desempenho Geral',
            data: [60, 65, 72, 78],
            borderColor: '#39ff14',
            backgroundColor: 'rgba(57,255,20,0.1)',
            fill: true,
            tension: 0.4
          }]
        },
        options: {
          responsive: true,
          scales: {
            y: { 
              grid: { color: 'rgba(255,255,255,0.05)' },
              ticks: { color: '#9ca3af' }
            },
            x: { 
              grid: { display: false },
              ticks: { color: '#9ca3af' }
            }
          },
          plugins: {
            legend: { display: false }
          }
        }
      });
    }
  }

  // Fechar modal ao clicar fora
  document.querySelectorAll('.modal').forEach(modal=>{
    modal.addEventListener('click',function(e){
      if(e.target===this) closeModal(this.id);
    });
  });
</script>
